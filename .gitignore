# ==============================================================================
# NagarWatch — Git Ignore Rules
# CRITICAL: NEVER COMMIT ENVIRONMENT FILES, SECRETS, OR PRIVATE KEYS
# ==============================================================================

# Environment files & Secrets
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Node / Frontend Build & Dependencies
node_modules/
*/node_modules/
dist/
*/dist/
build/
*/build/
.vite/
*/.vite/
.vitest-cache/
*/.vitest-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Root accidental package-lock
/package-lock.json

# Python Virtual Environments & Bytecode
venv/
.venv/
*/venv/
*/.venv/
ENV/
env/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/

# Local Uploads & Temp Files
uploads/
*/uploads/
*.log
*/logs/
tmp/
temp/
scripts/

# Operating System & IDE Artifacts
.DS_Store
*/.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
